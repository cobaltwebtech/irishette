{
  "name": "irishette",
  "version": "0.41.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "varlock run --inject vars -- cf dev",
    "build": "varlock run --inject vars -- cf build",
    "preview": "varlock run --inject vars -- vp preview",
    "deploy": "varlock run --inject vars -- cf deploy",
    "deploy:dry": "varlock run --inject vars -- cf deploy --dry-run",
    "env:check": "varlock load --agent",
    "env:scan": "varlock scan",
    "env:types": "varlock codegen --path .env.schema",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "types": "cf workers types",
    "typecheck": "cf workers types && tsc --noEmit && tsc --noEmit -p e2e",
    "tail": "pnpm dlx wrangler tail irishette",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "format": "vp fmt",
    "clean": "rm -rf dist .tanstack src/routeTree.gen.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:studio:remote": "DB_TARGET=remote drizzle-kit studio",
    "db:migrate:local": "node scripts/d1-local.mjs migrate",
    "db:migrate:remote": "cf d1 migrations apply 2a894e1e-33f0-45ce-88e1-2709f90215a9 --dir ./drizzle",
    "db:seed:local": "node scripts/d1-local.mjs seed",
    "db:reset:local": "rm -rf .cloudflare/state/v3/d1 && pnpm db:migrate:local && pnpm db:seed:local",
    "db:make-admin:local": "node scripts/d1-local.mjs make-admin",
    "test": "vp test run",
    "test:unit": "vp test run --project unit",
    "test:workers": "vp test run --project workers",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/drizzle-adapter": "1.7.18",
    "@better-auth/stripe": "1.7.18",
    "@iconify/react": "^6.0.4",
    "@marsidev/react-turnstile": "^1.6.3",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.1",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.3.1",
    "@trpc/client": "^11.25.0",
    "@trpc/server": "^11.25.0",
    "@trpc/tanstack-react-query": "^11.25.0",
    "@unpic/react": "^1.0.2",
    "better-auth": "1.7.18",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lenis": "^1.3.27",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.8",
    "recharts": "^3.10.1",
    "resend": "^6.37.0",
    "stripe": "23.1.0",
    "superjson": "^2.2.6",
    "swiper": "^14.4.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.3",
    "varlock": "^1.24.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@libsql/client": "^0.18.0",
    "@msw/cloudflare": "^0.2.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/devtools-vite": "^0.8.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "cf": "1.0.0-beta.28",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.4",
    "msw": "^3.0.4",
    "oxc-transform-react": "~0.156.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.18.0"
}
