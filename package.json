{
  "name": "irishette",
  "private": true,
  "type": "module",
  "version": "0.40.0",
  "scripts": {
    "dev": "vite dev --port 3000 --strictPort",
    "dev:cf": "vite build && pnpm wrangler dev",
    "lint": "biome lint",
    "format": "biome format --write",
    "build": "vite build",
    "deploy:cf": "pnpm run build && pnpm wrangler deploy",
    "serve": "vite preview",
    "clean": "rm -rf dist .tanstack src/routeTree.gen.ts",
    "up:biome": "pnpm up @biomejs/biome@latest && pnpm biome migrate --write",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:studio:remote": "DB_TARGET=remote drizzle-kit studio",
    "db:migrate:local": "CI=1 wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file scripts/seed-local.sql",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && pnpm db:migrate:local && pnpm db:seed:local",
    "db:make-admin:local": "node scripts/make-admin-local.mjs",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@better-auth/stripe": "1.6.9",
    "@marsidev/react-turnstile": "^1.6.3",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-query-devtools": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "^11.25.0",
    "@trpc/server": "^11.25.0",
    "@trpc/tanstack-react-query": "^11.25.0",
    "@unpic/react": "^1.0.2",
    "better-auth": "1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lenis": "^1.3.27",
    "nanoid": "^5.1.16",
    "react": "^19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.7",
    "recharts": "^3.10.1",
    "resend": "^6.37.0",
    "sonner": "^2.0.8",
    "stripe": "22.1.0",
    "superjson": "^2.2.6",
    "swiper": "^12.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
