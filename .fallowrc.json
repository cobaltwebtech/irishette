{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreExportsUsedInFile": true,
  "rules": {
    "unused-exports": "error",
    "unused-types": "error",
    "boundary-violation": "error",
    "policy-violation": "off"
  },
  "duplicates": {
    "threshold": 6
  },
  "overrides": [
    {
      "files": [
        "src/components/ui/**"
      ],
      "rules": {
        "unused-exports": "off",
        "unused-types": "off"
      }
    }
  ],
  "boundaries": {
    "zones": [
      {
        "name": "ui",
        "patterns": [
          "src/components/ui/**"
        ]
      },
      {
        "name": "email",
        "patterns": [
          "src/components/email/**"
        ]
      },
      {
        "name": "client",
        "patterns": [
          "src/components/**",
          "src/stores/**"
        ]
      },
      {
        "name": "server",
        "patterns": [
          "src/lib/auth/auth.ts",
          "src/lib/booking/booking-service.ts",
          "src/lib/booking/checkout-service.ts",
          "src/lib/booking/refund-service.ts",
          "src/lib/booking/dispute-service.ts",
          "src/lib/booking/availability.ts",
          "src/lib/server/deps.ts",
          "src/lib/email/email-service.ts",
          "src/lib/stripe/stripe.ts",
          "src/lib/stripe/stripe-webhook.ts",
          "src/lib/ical/ical-sync.ts",
          "src/lib/ical/ical-export.ts",
          "src/lib/server/scheduled-tasks.ts",
          "src/lib/server/admin-query.ts",
          "src/lib/booking/cancellation-policy-store.ts",
          "src/lib/security/rate-limit.ts",
          "src/lib/auth/server-auth.ts",
          "src/lib/inbox/inbox-service.ts",
          "src/lib/inbox/contact-service.ts",
          "src/lib/inbox/turnstile.ts",
          "src/lib/reports/tax-report-service.ts",
          "src/db/**",
          "src/server.ts",
          "src/integrations/trpc/init.ts",
          "src/integrations/trpc/access.ts",
          "src/integrations/trpc/context.ts",
          "src/integrations/trpc/inner-context.ts",
          "src/integrations/trpc/router.ts",
          "src/integrations/trpc/bookings.ts",
          "src/integrations/trpc/rooms.ts",
          "src/integrations/trpc/users.ts",
          "src/integrations/trpc/ical.ts",
          "src/integrations/trpc/policies.ts",
          "src/integrations/trpc/availability.ts",
          "src/integrations/trpc/inbox.ts",
          "src/integrations/trpc/reports.ts"
        ]
      },
      {
        "name": "shared",
        "patterns": [
          "src/lib/**",
          "src/utils/**",
          "src/integrations/trpc/react.ts",
          "src/integrations/trpc/types.ts",
          "src/integrations/trpc/errors.ts",
          "src/integrations/trpc/batching.ts"
        ]
      }
    ],
    "rules": [
      {
        "from": "ui",
        "allow": [
          "ui",
          "shared"
        ]
      },
      {
        "from": "email",
        "allow": [
          "email"
        ]
      },
      {
        "from": "client",
        "allow": [
          "ui",
          "client",
          "shared"
        ],
        "allowTypeOnly": [
          "server"
        ]
      },
      {
        "from": "shared",
        "allow": [
          "shared"
        ],
        "allowTypeOnly": [
          "server"
        ]
      }
    ]
  }
}
