// Folder-specific settings
// https://zed.dev/docs/configuring-zed#settings-files
// Requires the oxc-zed extension (formatting/linting via Vite+).
{
  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": { "run": "onType", "fixKind": "safe_fix" }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": { "fmt.configPath": "./vite.config.ts", "run": "onSave" }
      }
    },
    "vscode-css-language-server": {
      "settings": { "css": { "lint": { "unknownAtRules": "ignore" } } }
    }
  },
  "languages": {
    "JavaScript": {
      "language_servers": ["!biome", "..."],
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "TypeScript": {
      "language_servers": ["!biome", "..."],
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "TSX": {
      "language_servers": ["!biome", "..."],
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "JSON": {
      "language_servers": ["!biome", "..."],
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSONC": {
      "language_servers": ["!biome", "..."],
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "CSS": {
      "language_servers": ["!biome", "..."],
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    }
  }
}
