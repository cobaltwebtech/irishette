# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=infer @defaultSensitive=true
# @currentEnv=$APP_ENV
# @generateTsTypes(path=./varlock.d.ts, exposeEnv=global, processEnv=none, importMetaEnv=none)
# ----------

# Build target. `development` unless a script sets it: only `pnpm build:prod`,
# `pnpm run deploy` and `pnpm deploy:dry` run with APP_ENV=production.
# production also loads `.env.production` (gitignored; real production values,
# loaded after `.env.local`, so it wins) and makes cloudflare.config.ts bind the
# production D1 database and custom domain. See docs/GO_LIVE.md.
# @public @type=enum(development, production)
APP_ENV=development

# Public / non-secret values (opt out of @defaultSensitive). They are baked into
# the build, so a production build needs the production values in
# `.env.production`: BETTER_AUTH_URL=https://www.irishette.com (exactly, no
# trailing slash), a pk_live_ publishable key and the production Turnstile site
# key. cloudflare.config.ts fails the build if any of them is a dev value.
# @public @required=forEnv(production)
VITE_TURNSTILE_PUBLIC_KEY=
# @public @required=forEnv(production)
STRIPE_PUBLISHABLE_KEY=
# @public @type=url @required=forEnv(production)
BETTER_AUTH_URL=

# Secrets (sensitive by default). Local dev reads them from `.env.local`;
# production secrets are set on the Worker with `wrangler secret put`, never
# from these files.
BETTER_AUTH_SECRET=
STRIPE_SECRET_KEY=
STRIPE_TRPC_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=
