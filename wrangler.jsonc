{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "irishette",
	"main": "./src/server.ts",
	"compatibility_date": "2025-09-21",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"BETTER_AUTH_URL": "https://irishette.cobaltdev.workers.dev"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "irishette-dev",
			"database_id": "7a52bbfc-592e-4792-990e-6a5e51ca8cbd",
			"migrations_dir": "./drizzle"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV_ICAL_SYNC_LOG",
			"id": "481a64572c1145de958404c9512755d6"
		}
	],
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			// Every 30 minutes - sync external calendars
			"*/30 * * * *",
			// Weekly on Sunday at 2 AM - cleanup old logs
			"0 2 * * 7"
		]
	}
}