{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "irishette",
	"main": "./src/server.ts",
	"compatibility_date": "2025-10-11",
	"compatibility_flags": [
		"nodejs_compat"
	],
  "workers_dev": true, // Set to false when going to production with a custom domain
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "irishette-dev",
			"database_id": "7a52bbfc-592e-4792-990e-6a5e51ca8cbd",
			"migrations_dir": "./drizzle"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV_ICAL_SYNC_LOG",
			"id": "481a64572c1145de958404c9512755d6"
		}
	],
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			// Every 30 minutes run calendar sync
			"*/30 * * * *",
			// Every 24 hours at 8:05 AM (UTC) - cleanup expired pending bookings
			"5 8 * * *",
			// Every 24 hours at 9:15AM (UTC) - cleanup iCal sync logs
			"15 9 * * *"
		]
	}
}
