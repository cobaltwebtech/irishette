{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "irishette",
	"main": "./src/server.ts",
	"compatibility_date": "2025-10-11",
	"compatibility_flags": [
		"nodejs_compat"
	],
  "workers_dev": true, // Set to false when going to production with a custom domain
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "irishette-dev",
			"database_id": "7a52bbfc-592e-4792-990e-6a5e51ca8cbd",
			"migrations_dir": "./drizzle"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV_ICAL_SYNC_LOG",
			"id": "481a64572c1145de958404c9512755d6"
		}
	],
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			// Every 30 minutes - sync external calendars
			"*/30 * * * *",
			// Every hour at 5 mins past run cleanup on abandoned bookings
			"25 * * * *",
			// Weekly on Sunday at 2 AM - clean up old logs
			"0 2 * * SUN"
		]
	}
}
